<?xml version="1.0" encoding="UTF-8"?>
<server description="Guess the Number with Duke">

    <!-- Naming the platforms lets every feature below stay versionless: Liberty resolves
         each one to the version that platform ships. -->
    <featureManager>
        <platform>jakartaee-11.0</platform>
        <platform>microProfile-7.1</platform>
        <feature>restfulWS</feature>
        <feature>jsonb</feature>
        <feature>cdi</feature>
        <feature>servlet</feature>
        <feature>beanValidation</feature>
        <feature>persistence</feature>
        <feature>data</feature>
        <feature>jdbc</feature>
        <feature>mpOpenAPI</feature>
        <feature>mpTelemetry</feature>
    </featureManager>

    <!-- 9081 and 9444 keep this demo clear of the other demos in this repository, which
         take the usual 9080 and 9443. -->
    <variable name="http.port" defaultValue="9081"/>
    <variable name="https.port" defaultValue="9444"/>

    <!-- These defaults match compose.yaml, so a fresh clone runs with no setup. Each one
         can be overridden by an environment variable of the same name. -->
    <variable name="DB_HOST" defaultValue="localhost"/>
    <variable name="DB_PORT" defaultValue="5435"/>
    <variable name="DB_NAME" defaultValue="dukeguess"/>
    <variable name="DB_USER" defaultValue="duke"/>
    <variable name="DB_PASSWORD" defaultValue="duke"/>

    <httpEndpoint id="defaultHttpEndpoint" host="localhost"
                  httpPort="${http.port}" httpsPort="${https.port}"/>

    <library id="postgresqlDriver">
        <fileset dir="${server.config.dir}/lib/postgresql" includes="*.jar"/>
    </library>

    <dataSource id="leaderboardDataSource" jndiName="jdbc/leaderboard">
        <jdbcDriver libraryRef="postgresqlDriver"/>
        <properties.postgresql serverName="${DB_HOST}" portNumber="${DB_PORT}" databaseName="${DB_NAME}"
                               user="${DB_USER}" password="${DB_PASSWORD}"/>
    </dataSource>

    <!-- The built-in Jakarta Data provider creates the leaderboard table on first use, so a
         fresh database needs no manual step. Set createTables="false" and hand the DDL to a
         database administrator instead if the application's database user may not create
         tables. -->
    <data createTables="true" dropTables="false"/>

    <!-- Application and OpenTelemetry messages reach console.log at INFO, which is where the
         exported telemetry shows up. -->
    <logging consoleLogLevel="INFO" consoleFormat="simple" messageFormat="simple"/>

    <applicationManager autoExpand="true"/>

    <webApplication id="jakarta-ee-demo-claude-code-opus-5_2"
                    location="jakarta-ee-demo-claude-code-opus-5_2.war" contextRoot="/"/>
</server>
