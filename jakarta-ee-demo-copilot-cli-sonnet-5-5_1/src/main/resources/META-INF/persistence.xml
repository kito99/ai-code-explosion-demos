<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                 https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <persistence-unit name="leaderboard" transaction-type="JTA">
        <jta-data-source>jdbc/leaderboard</jta-data-source>
        <class>com.example.guessthenumber.leaderboard.LeaderboardEntry</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <!-- Creates the leaderboard table on first start and leaves an existing one
                 alone, so a fresh database needs no manual step and a restart is quiet. -->
            <property name="eclipselink.ddl-generation" value="create-or-extend-tables"/>
            <property name="eclipselink.ddl-generation.output-mode" value="database"/>
            <!-- Runs the DDL at deployment, outside any request transaction: on PostgreSQL the
                 existence probe fails inside a transaction and would abort it. -->
            <property name="eclipselink.deploy-on-startup" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
