<?xml version="1.0" encoding="UTF-8"?>
<server description="Guess the Number with Duke — Open Liberty server">

    <featureManager>
        <feature>jakartaee-11.0</feature>
        <feature>microProfile-7.1</feature>
        <feature>data-1.0</feature>
    </featureManager>

    <variable name="default.http.port"  defaultValue="9080"/>
    <variable name="default.https.port" defaultValue="9443"/>
    <variable name="db.host"            defaultValue="localhost"/>
    <variable name="db.port"            defaultValue="5432"/>
    <variable name="db.name"            defaultValue="guessdb"/>
    <variable name="db.user"            defaultValue="guessuser"/>
    <variable name="db.password"        defaultValue="guesspass"/>

    <httpEndpoint id="defaultHttpEndpoint"
                  httpPort="${default.http.port}"
                  httpsPort="${default.https.port}"/>

    <!-- PostgreSQL JDBC driver -->
    <library id="postgresLib">
        <fileset dir="${shared.resource.dir}/postgres" includes="*.jar"/>
    </library>

    <!-- DataSource — id="DefaultDataSource" is required by Jakarta Data -->
    <dataSource id="DefaultDataSource" jndiName="jdbc/guessdb">
        <jdbcDriver libraryRef="postgresLib"/>
        <properties.postgresql
            serverName="${db.host}"
            portNumber="${db.port}"
            databaseName="${db.name}"
            user="${db.user}"
            password="${db.password}"/>
        <connectionManager maxPoolSize="10" minPoolSize="1"/>
    </dataSource>

    <!-- Application -->
    <webApplication id="guess"
                    location="${server.config.dir}/apps/jakarta-ee-demo-bob-claude-opus-4-5_3.war"
                    name="jakarta-ee-demo-bob-claude-opus-4-5_3">
        <classloader apiTypeVisibility="spec, ibm-api, api, stable, third-party"/>
    </webApplication>

</server>
