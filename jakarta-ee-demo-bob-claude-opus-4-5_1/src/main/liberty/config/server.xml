<?xml version="1.0" encoding="UTF-8"?>
<server description="Guess the Number with Duke - Open Liberty Server">

    <featureManager>
        <!-- Jakarta EE 11 full platform convenience feature (includes data-1.0, persistence-3.2, restfulWS-4.0, etc.) -->
        <feature>jakartaee-11.0</feature>
    </featureManager>

    <httpEndpoint id="defaultHttpEndpoint"
                  httpPort="${http.port}"
                  httpsPort="${https.port}" />

    <webApplication location="jakarta-ee-demo-bob-claude-opus-4-5_1.war"
                    contextRoot="/" />

    <!-- Embedded Derby datasource for the leaderboard (no external DB required) -->
    <dataSource id="DefaultDataSource" jndiName="jdbc/leaderboard">
        <jdbcDriver libraryRef="DerbyLib" />
        <properties.derby.embedded databaseName="${server.output.dir}/data/leaderboard"
                                   createDatabase="create" />
    </dataSource>

    <library id="DerbyLib">
        <fileset dir="${shared.resource.dir}/derby" includes="*.jar" />
    </library>

    <variable name="http.port" defaultValue="9080" />
    <variable name="https.port" defaultValue="9443" />

    <logging consoleLogLevel="INFO" />

</server>
